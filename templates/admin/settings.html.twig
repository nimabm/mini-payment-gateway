{% extends 'admin/layout.html.twig' %}
{% set active = 'settings' %}

{% block title %}{{ t('settings.title') }}{% endblock %}
{% block heading %}{{ t('settings.title') }}{% endblock %}

{% block content %}
    <form method="post" action="/admin/settings">
        <input type="hidden" name="_token" value="{{ csrfToken }}">

        <div class="grid grid-2">
            <div class="card">
                <h2>{{ t('settings.appearance') }}</h2>

                <div class="field">
                    <label for="locale">{{ t('settings.locale') }}</label>
                    <select id="locale" name="locale">
                        {% for available in locales %}
                            <option value="{{ available.value }}"
                                    {{ settings['panel.locale']|default('fa') == available.value ? 'selected' }}>
                                {{ available.nativeName }}
                            </option>
                        {% endfor %}
                    </select>
                </div>

                <div class="field">
                    <label for="calendar">{{ t('settings.calendar') }}</label>
                    <select id="calendar" name="calendar">
                        {% for available in calendars %}
                            <option value="{{ available.value }}"
                                    {{ settings['panel.calendar']|default('jalali') == available.value ? 'selected' }}>
                                {{ t('settings.calendar.' ~ available.value) }}
                            </option>
                        {% endfor %}
                    </select>
                    <div class="hint">{{ panel().calendar.inputHint }}</div>
                </div>

                <div class="field">
                    <label for="timezone">{{ t('settings.timezone') }}</label>
                    <select id="timezone" name="timezone" dir="ltr">
                        {% for zone in timezones %}
                            <option value="{{ zone }}"
                                    {{ settings['panel.timezone']|default('UTC') == zone ? 'selected' }}>
                                {{ zone }}
                            </option>
                        {% endfor %}
                    </select>
                </div>

                <div class="field">
                    <label for="page_size">{{ t('settings.page_size') }}</label>
                    <input type="number" id="page_size" name="page_size" dir="ltr" min="10" max="200"
                           value="{{ settings['panel.page_size']|default('25') }}">
                </div>

                <div class="field">
                    <label for="brand_name">{{ t('settings.brand_name') }}</label>
                    <input type="text" id="brand_name" name="brand_name"
                           value="{{ settings['checkout.brand_name']|default('') }}">
                </div>
            </div>

            <div class="card">
                <h2>{{ t('settings.gateways') }}</h2>

                <div class="field">
                    <div class="checkbox">
                        <input type="checkbox" id="force_sandbox" name="force_sandbox"
                               {{ settings['gateways.force_sandbox']|default('0') == '1' ? 'checked' }}>
                        <label for="force_sandbox" style="margin:0">{{ t('settings.force_sandbox') }}</label>
                    </div>
                    <div class="hint">{{ t('settings.force_sandbox_hint') }}</div>
                </div>
            </div>
        </div>

        <div class="row">
            <button type="submit" class="btn btn-primary">{{ t('settings.save') }}</button>
        </div>
    </form>

    {% if currentUser %}
        <div class="card" style="margin-top:18px">
            <h2>{{ t('settings.appearance') }} — {{ currentUser.email }}</h2>
            <p class="muted">
                {# A per-user override, so one operator switching to English does
                   not change the panel for everybody else. #}
                {{ t('settings.locale') }} / {{ t('settings.calendar') }}
            </p>

            <form method="post" action="/admin/settings/preferences" class="row">
                <input type="hidden" name="_token" value="{{ csrfToken }}">

                <select name="locale" style="width:auto">
                    <option value="">{{ t('common.none') }}</option>
                    {% for available in locales %}
                        <option value="{{ available.value }}"
                                {{ currentUser.locale() and currentUser.locale().value == available.value ? 'selected' }}>
                            {{ available.nativeName }}
                        </option>
                    {% endfor %}
                </select>

                <select name="calendar" style="width:auto">
                    <option value="">{{ t('common.none') }}</option>
                    {% for available in calendars %}
                        <option value="{{ available.value }}"
                                {{ currentUser.calendar() and currentUser.calendar().value == available.value ? 'selected' }}>
                            {{ t('settings.calendar.' ~ available.value) }}
                        </option>
                    {% endfor %}
                </select>

                <button type="submit" class="btn">{{ t('common.save') }}</button>
            </form>
        </div>

        <div class="card" style="margin-top:18px">
            <h2>{{ t('password.title') }}</h2>
            <p class="muted">{{ t('password.hint', {'min': minimumPasswordLength}) }}</p>

            <form method="post" action="/admin/settings/password">
                <input type="hidden" name="_token" value="{{ csrfToken }}">

                {# autocomplete hints let a password manager offer to update the
                   stored entry instead of saving a second one. #}
                <div class="grid grid-2">
                    <div class="field">
                        <label for="current_password">{{ t('password.current') }}</label>
                        <input type="password" id="current_password" name="current_password"
                               autocomplete="current-password" required>
                    </div>

                    <div></div>

                    <div class="field">
                        <label for="new_password">{{ t('password.new') }}</label>
                        <input type="password" id="new_password" name="new_password"
                               autocomplete="new-password"
                               minlength="{{ minimumPasswordLength }}" required>
                    </div>

                    <div class="field">
                        <label for="confirm_password">{{ t('password.confirm') }}</label>
                        <input type="password" id="confirm_password" name="confirm_password"
                               autocomplete="new-password"
                               minlength="{{ minimumPasswordLength }}" required>
                    </div>
                </div>

                <div class="row">
                    <button type="submit" class="btn btn-primary">{{ t('password.submit') }}</button>
                </div>
            </form>
        </div>
    {% endif %}
{% endblock %}
