# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_ENV=production
APP_DEBUG=false

# Public base URL of this gateway. Used to build checkout and callback URLs
# that are handed to the PSPs, so it MUST be reachable from the internet
# in production.
APP_URL=http://localhost:8080

# Timezone used only for rendering. Everything is stored in UTC.
APP_TIMEZONE=Asia/Tehran

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
# 32 random bytes, base64 encoded. Encrypts PSP credentials at rest.
# Generate with: make key    (or: openssl rand -base64 32)
APP_KEY=

# How far a signed API request's timestamp may drift, in seconds.
API_SIGNATURE_TOLERANCE=300

# Requests per minute, per API key.
API_RATE_LIMIT=120

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
DB_PATH=/var/lib/gateway/gateway.sqlite

# ---------------------------------------------------------------------------
# Payment behaviour
# ---------------------------------------------------------------------------
# A payment that is never taken to the bank expires after this many minutes.
PAYMENT_TTL_MINUTES=30

# Maximum number of gateways tried for one payment before giving up.
CHECKOUT_MAX_FAILOVER=3

# Webhook retry schedule (minutes, comma separated). One entry per attempt.
WEBHOOK_RETRY_SCHEDULE=1,5,30,120,360,1440

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_LEVEL=info

# Structured JSON goes to stderr, which is where a container's logs belong —
# `docker compose logs` then pipes straight into whatever collects them.
# A file path works too, if you would rather keep logs in the data volume.
LOG_PATH=php://stderr
